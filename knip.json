{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Next.js routes, layouts, opengraph images etc. are found by knip's Next plugin.
  // One-off scripts are ENTRY files rather than ignored: an ignored file's imports
  // would not count, and several entity modules (entities/team/lib/family-screen.ts,
  // entities/team/lib/role-families.ts) are used only from scripts/. As entries their
  // imports keep those exports alive while their own exports are not reported.
  // `entities/*/mounts.ts` is read as text by scripts/gen-app-mounts.mjs, which
  // writes every route file under app/ from it. Nothing imports it — that is
  // the point, the composition root assembles it — so it is an ENTRY rather
  // than an ignore: as an entry its own type import keeps
  // kernel/config/route-mount.ts alive, which an ignore would not.
  // `entities/*/permissions.ts` and kernel/identity/permissions.ts are the access
  // declarations (ADR 0013), read as text by scripts/gen-deployment.mjs the same
  // way, and entries for the same reason.
  "entry": [
    "scripts/**/*.{ts,mts,mjs}",
    ".github/scripts/**/*.mjs",
    "entities/*/mounts.ts",
    "entities/*/permissions.ts",
    "kernel/identity/permissions.ts"
  ],
  "project": ["**/*.{ts,tsx,js,mjs}"],
  "ignore": [
    // Standalone video-rendering project with its own toolchain; excluded from tsconfig too.
    "video/**",
    // Files rsync'd over the public 8-Edges-Fork by the fork-sync workflow; nothing in
    // this repo imports them by design.
    ".github/fork-overlay/**",
    // Deno edge functions, deployed by the Supabase CLI; not part of the Node graph.
    "supabase/functions/**",
    // Generated by `npm run gen:types` (AR-01). It exports every helper the Supabase
    // CLI emits (Tables, Enums, Constants, ...) whether or not the app uses them yet,
    // and trimming the output would break the byte-for-byte freshness check.
    "kernel/data/supabase/database.types.ts",
    // Empty client doors (ME-13): every entity has entities/<name>/client.ts so a
    // "use client" component has a browser-safe way in, and these export nothing
    // yet because no client component outside the entity consumes them. Contacts
    // and client-programs joined the list in RS-01, which gave them ownership of
    // their tables before their screens move across; boards' door carries the
    // card and lane shapes, which its own client components take by relative
    // path. A file nothing imports is what knip reports; drop the line when the
    // door gains its first outside consumer, so its exports are reported again.
    "entities/billing/client.ts",
    "entities/htt/client.ts",
    "entities/finance/client.ts",
    "entities/campaigns/client.ts",
    // CommonJS on purpose (next/og is required, not imported). knip reads its
    // `module.exports = {...}` as a default export that nothing imports, while the
    // twelve opengraph-image routes take its members as named imports through
    // the bundler's CJS interop. Until ME-13 the lib/ogRender.js shim's
    // `require` kept knip quiet; the shim is gone, so the entry is listed here.
    "entities/site/lib/ogRender.js"
  ],
  // scripts/calls/sync-lark-minutes.mjs shells out to the Lark CLI, installed per machine;
  // scripts/gen-supabase-types.mjs shells out to the Supabase CLI (brew locally,
  // supabase/setup-cli in the types-fresh CI job). Neither is an npm dependency.
  "ignoreBinaries": ["lark-cli", "supabase"],
  // A cron's `schedule` is read as text by scripts/gen-deployment.mjs, which
  // writes vercel.json's crons array from the installed entities. Nothing
  // imports it, which is the point: the schedule lives beside the routine and
  // the composition root assembles it.
  "tags": ["-generator"],
  "ignoreExportsUsedInFile": true
}
