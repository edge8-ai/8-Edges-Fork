// Derived from the upstream's knip.json by its fork sync (fork-knip.mjs there):
// patterns that match nothing here are dropped, and the code whose only
// consumers the sync removed is ignored. Edit freely once this is your repo.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{ts,mts,mjs}",
    "entities/*/mounts.ts",
    "entities/*/permissions.ts",
    "entities/*/slots.ts",
    "kernel/identity/permissions.ts"
  ],
  "project": [
    "**/*.{ts,tsx,js,mjs}"
  ],
  "ignore": [
    "kernel/data/supabase/database.types.ts",
    "entities/billing/client.ts",
    "entities/finance/client.ts",
    "entities/campaigns/client.ts",
    "entities/ladders/client.ts"
  ],
  "ignoreBinaries": [
    "lark-cli",
    "supabase"
  ],
  "tags": [
    "-generator"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreFiles": [
    "entities/billing/lib/private-session-booking.ts",
    "entities/campaigns/lib/email-schedule.ts",
    "entities/campaigns/lib/letter/actions.ts",
