{
  "name": "edge8-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/design/check-tokens.mjs",
    "build": "node scripts/next-build.mjs",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ app kernel entities",
    "check:design": "node scripts/design/check-assets.mjs",
    "check:tokens": "node scripts/design/check-tokens.mjs",
    "check:crons": "node scripts/check-crons.mjs",
    "check:read-errors": "node scripts/check-read-errors.mjs",
    "check:action-auth": "node scripts/check-action-auth.mjs",
    "check:ai-routing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-ai-routing.mjs",
    "check:prompt-evals": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-prompt-evals.mjs",
    "eval:prompt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prompt-evals/eval.mjs",
    "check:private-pages": "node scripts/check-private-pages.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:credential-tables": "node scripts/check-credential-tables.mjs",
    "check:file-sizes": "node scripts/check-file-sizes.mjs",
    "check:lint-warnings": "node scripts/check-lint-warnings.mjs",
    "check:tracing": "node scripts/check-tracing-includes.mjs",
    "check:design-ratchet": "node scripts/check-design-ratchet.mjs",
    "gen:entity-zones": "node scripts/gen-entity-zones.mjs",
    "check:entity-zones": "node scripts/gen-entity-zones.mjs --check",
    "gen:fork-excludes": "node scripts/gen-fork-excludes.mjs",
    "check:fork-safe": "node scripts/check-fork-safe.mjs",
    "check:agent-config": "node scripts/check-agent-config-privacy.mjs",
    "check:fork-excludes": "node scripts/gen-fork-excludes.mjs --check",
    "check:portability": "node scripts/check-portability.mjs",
    "check:entity-imports": "node scripts/check-entity-imports.mjs",
    "check:requires": "node scripts/check-requires.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "gen:deployment": "node scripts/gen-deployment.mjs",
    "gen:app-mounts": "node scripts/gen-app-mounts.mjs",
    "check:generated": "node scripts/gen-deployment.mjs --check",
    "check:app-mounts": "node scripts/gen-app-mounts.mjs --check",
    "check:access": "node scripts/check-access.mjs",
    "access:sync": "node scripts/access-sync.mjs",
    "audit:parity": "node scripts/audit-parity.mjs",
    "audit:wiring": "node scripts/audit-action-wiring.mjs",
    "audit:vocab": "node scripts/audit-shared-vocab.mjs",
    "audit:leave-approvals": "node scripts/audit-leave-approvals.mjs",
    "check:table-ownership": "node scripts/check-table-ownership.mjs",
    "postbuild": "node scripts/check-tracing-includes.mjs",
    "gen:types": "node scripts/gen-supabase-types.mjs",
    "publish:doc": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/library/publish.mjs",
    "check:types-fresh": "node scripts/gen-supabase-types.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check:data-dictionary": "node scripts/data-dictionary/generate.mjs --check",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run check:action-auth && npm run check:ai-routing && npm run check:prompt-evals && npm run check:read-errors && npm run check:private-pages && npm run check:migrations && npm run check:credential-tables && npm run check:file-sizes && npm run check:lint-warnings && npm run check:design-ratchet && npm run check:utilities-scope && npm run check:entity-zones && npm run check:entity-imports && npm run check:requires && npm run check:deployment && npm run check:generated && npm run check:app-mounts && npm run check:access && npm run check:table-ownership && npm run check:portability && npm run check:fork-excludes && npm run check:fork-safe && npm run check:data-dictionary && npm run check:agent-config && npm run check:design && npm run check:crons && npm run check:tokens && npm run check:tracing -- --if-built && npm test",
    "check:utilities-scope": "node scripts/check-utilities-scope.mjs",
    "ship:content": "scripts/ship-content.sh",
    "board:export": "node scripts/board/export-tickets.mjs",
    "board:status": "node scripts/board/card-status.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.5",
    "hast-util-raw": "^9.1.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "mammoth": "^1.12.0",
    "mdast-util-to-hast": "^13.2.1",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "resend": "^6.12.4",
    "stripe": "^22.2.1",
    "tus-js-client": "^4.3.1",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "knip": "^6.34.0",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18"
  }
}
